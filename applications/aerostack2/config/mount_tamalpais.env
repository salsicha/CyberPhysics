# Mount Tamalpais mission/deployment configuration. This describes where the
# Aerodrone is deployed, not another physical system.
INITIAL_LAT=37.9234
INITIAL_LON=-122.5967
ORIGIN_ALT=781.0
AREA_KM=8.0
SEARCH_RADIUS_M=900.0
# Upper bounds of the DemNav/WildNav search radius as it grows with the
# fused prior's uncertainty (3x the base radii).
MAX_SEARCH_RADIUS_M=2700.0
DEM_RESOLUTION_M=10.0
# Lowest height above ground of the simulated wilderness mission's en-route
# waypoints (take-off and landing keep the mission's own). Below about 250 m
# the depth footprint spans too few DEM posts for DemNav to find a unique
# match inside its 900-2700 m search window. A simulation setting: the real
# aircraft's nominal ceiling is 120 m (systems/aerodrone/config/sensors.yaml).
CRUISE_AGL_M=250.0
FOV_DEG=69.0
WILDNAV_ZOOM=17
WILDNAV_SEARCH_RADIUS_M=1100.0
WILDNAV_MAX_SEARCH_RADIUS_M=3300.0
WILDNAV_MAX_TILES=169
WILDNAV_MAX_DOWNLOADS=8
WILDNAV_RATE_HZ=0.2
WILDNAV_FEATURE_BACKEND=SIFT
WILDNAV_MIN_MATCHES=16
WILDNAV_MIN_INLIERS=10
WILDNAV_MIN_INLIER_RATIO=0.25
DEMNAV_MIN_CORRELATION=0.35
DEMNAV_MIN_FOOTPRINT_PIXELS=3
DEMNAV_FUSION_CONFIDENCE=0.35
WILDNAV_FUSION_CONFIDENCE=0.20
