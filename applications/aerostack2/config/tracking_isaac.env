# Object tracking in the Isaac stack: compositions/aerostack2_isaac.yaml includes
# compositions/aerodrone_tracking.yaml and aerodrone_tracking_sim.yaml with
# topics.env, tracking.env and this file.

# The simulator stacks' image tag (aerodrone_tracking.yaml's fallback is the
# aircraft's arm64).
CYBERPHYSICS_TAG=latest
# The stack's DemNav DEM cache volume (seeded by demnav_assets).
TRACKING_DEM_SOURCE=demnav_isaac_cache
# The camera mount DemNav and WildNav use in this stack. Isaac's USD
# camera looks down body -z, rotated so image top points toward the nose.
TRACKING_CAMERA_MOUNT_YAW_DEG=0.0
TRACKING_CAMERA_STABILIZED=false
# The tracker runs on the simulation clock (/clock): its timeouts, filter,
# lead and speed limits are simulation seconds, as ArduPilot's (the
# simulator may run slower than real time).
TRACKING_USE_SIM_TIME=true
# Every ROS container of the simulator stacks loads the shared FastDDS
# profile (applications/aerostack2/README.md, "DDS transport").
FASTRTPS_DEFAULT_PROFILES_FILE=/workspace/systems/aerodrone/config/fastdds.xml
# CAD OAK-1 lens position in body FLU metres; shared by both backends.
TRACKING_CAMERA_OFFSET_M=[0.14215,0.0,-0.0798]
# The foam dart launcher's fire control (systems/aerodrone/tracking.md, "Foam
# dart launcher") against aerodrone_tracking_sim.yaml's stand-in launcher.
TRACKING_LAUNCHER_FITTED=true
