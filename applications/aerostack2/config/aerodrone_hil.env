# Aerodrone hardware-in-the-loop (tools/aerodrone_hil_test.md): the Gazebo
# simulator, ArduPilot SITL and the OAK-1 stand-in on the workstation
# (tools/aerodrone_hil_sim.yaml over aerostack2_sim.yaml), the
# companion stack on the BlueOS Raspberry Pi 5 (tools/aerodrone_hil_pi.yaml
# over aerodrone_hardware.yaml), linked over Wi-Fi. Both hosts read this file
# with --env-file, after systems/aerodrone/config/topics.env and
# applications/aerostack2/config/mount_tamalpais.env (the simulated site).

# The two hosts' Wi-Fi addresses. Every link between them is pinned to these:
# the Pi's Ethernet (BlueOS's tether, and a 10.0.0.0/24 LAN here) is not used.
HIL_SIM_HOST=192.168.1.116
HIL_PI_HOST=192.168.1.193

ROS_DOMAIN_ID=68

# Native Zenoh (systems/ros2/README.md) without multicast: one router per host
# on HIL_ZENOH_PORT (7447 is BlueOS's), the Pi's connecting to the
# workstation's, which is the only ROS session across Wi-Fi; every ROS node
# is a peer listening on loopback only, connected to its host's router, and
# reaches the other peers on its host directly (the routers' gossip goes to
# their own peers only). Data crosses once per topic, router to router.
HIL_ZENOH_PORT=7468
ZENOH_CONFIG_OVERRIDE=mode="peer";scouting/multicast/enabled=false;scouting/gossip/autoconnect={router:[],peer:["peer"]};listen/endpoints=["tcp/127.0.0.1:0"];connect/endpoints=["tcp/127.0.0.1:${HIL_ZENOH_PORT}"]
# Wait for the router.
ZENOH_ROUTER_CHECK_ATTEMPTS=0

# The Pi's MAVROS to ArduPilot SITL's first serial port on the workstation
# (TCP: ordered and reliable over Wi-Fi, SITL's own server, and the same
# transport as the aircraft's link to BlueOS's router, tcp://127.0.0.1:5777).
BLUEOS_FCU_URL=tcp://${HIL_SIM_HOST}:5760

# The OAK-1 stand-in's wall-stamped colour frames for the tracking detector,
# on the workstation only.
HIL_TRACKING_INPUT_PREFIX=/hil/oak1/tracking_input

# The Pi: its DemNav DEM and WildNav tile caches and the mission tree, copied
# from the workstation's seeded volumes by tools/aerodrone_hil_test.sh
# (relative to compositions/; generated/ is not tracked).
DEMNAV_CACHE_HOST=../generated/aerodrone_hil/pi/demnav_cache
WILDNAV_CACHE_HOST=../generated/aerodrone_hil/pi/wildnav_cache
HIL_PI_ASSETS=../generated/aerodrone_hil/pi/assets
# The seeded tile cache is complete for the simulated site, as in the Gazebo
# stack (max_tile_downloads_per_cycle 0).
WILDNAV_MAX_DOWNLOADS=0

# The simulated mission's take-off height (aerostack2_sim.yaml).
TAKEOFF_ALTITUDE=35.0

# Object tracking on the Pi: the aircraft's wall clock, the launcher's fire
# control against the workstation's launcher stand-in, the Gazebo camera's
# mount (nadir, image top toward the nose, body-fixed, as the aircraft's).
TRACKING_USE_SIM_TIME=false
TRACKING_LAUNCHER_FITTED=true
TRACKING_CAMERA_MOUNT_YAW_DEG=0.0
TRACKING_CAMERA_STABILIZED=false

# Containers on the Pi: hil_* names, apart from the aircraft's.
MAVROS_CONTAINER=hil_mavros
NAVIGATION_BRIDGE_CONTAINER=hil_navigation_bridge
OAK1_CONTAINER=hil_oak1
DEMNAV_CONTAINER=hil_demnav
WILDNAV_CONTAINER=hil_wildnav
ROSBRIDGE_CONTAINER=hil_rosbridge
