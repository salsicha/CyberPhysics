<launch>
  <arg name="fcu_url" default="tcp://127.0.0.1:5777"/>
  <!-- Parameters of the link to the flight controller, loaded after
       ArduPilot's stock MAVROS configuration. On the aircraft MAVROS and
       ArduPilot share the Pi and the default (the plugin list again) changes
       nothing. Over a network (the hardware-in-the-loop test's Wi-Fi to
       ArduPilot SITL, tools/aerodrone_hil_test.md) MAVROS's time
       synchroniser needs mavros_time_wifi.yaml. -->
  <arg name="link_config_yaml" default="/workspace/mavros_config/mavros_plugins.yaml"/>
  <!-- MAVROS's node.launch with one more parameter file. -->
  <node pkg="mavros" exec="mavros_node" output="screen">
    <param name="fcu_url" value="$(var fcu_url)"/>
    <param name="gcs_url" value=""/>
    <param name="tgt_system" value="1"/>
    <param name="tgt_component" value="1"/>
    <param name="fcu_protocol" value="v2.0"/>
    <param from="/workspace/mavros_config/mavros_plugins.yaml"/>
    <param from="$(find-pkg-share mavros)/launch/apm_config.yaml"/>
    <param from="$(var link_config_yaml)"/>
  </node>
</launch>
