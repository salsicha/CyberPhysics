{% if sensor.model == 'gimbal_speed' or sensor.model == 'gimbal_position' -%}
<model name='{{ sensor.sensor_attached }}'>
{% else -%}
<model name='{{ sensor.name }}'>
  <pose relative_to="base_link">{{ sensor.pose }}</pose>
{% endif -%}
  <link name="rgbd_camera">
    <inertial><mass>0.005</mass><inertia>
      <ixx>8.33e-06</ixx><ixy>0</ixy><ixz>0</ixz>
      <iyy>8.33e-06</iyy><iyz>0</iyz><izz>8.33e-06</izz>
    </inertia></inertial>
    <sensor name="rgbd_camera" type="rgbd_camera">
      <always_on>true</always_on><update_rate>5</update_rate>
      <camera name="rgbd_camera">
        <horizontal_fov>1.0472</horizontal_fov>
        <lens><intrinsics><fx>277.1</fx><fy>277.1</fy><cx>160.5</cx><cy>120.5</cy><s>0</s></intrinsics></lens>
        <image><width>320</width><height>240</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>300</far></clip>
        <depth_camera><clip><near>0.3</near><far>200</far></clip></depth_camera>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.007</stddev></noise>
{% if sensor.model == 'gimbal_speed' or sensor.model == 'gimbal_position' -%}
        <optical_frame_id>/{{ namespace }}/{{ sensor.name }}/_0/_1/_2/{{ sensor.sensor_attached }}/{{ sensor.sensor_attached_type }}/rgbd_camera/optical_frame</optical_frame_id>
{% else -%}
        <optical_frame_id>/{{ namespace }}/{{ sensor.name }}/{{ sensor.model }}/rgbd_camera/optical_frame</optical_frame_id>
{% endif -%}
      </camera>
    </sensor>
  </link>
  <frame name="mount_point"/>
</model>
{% if sensor.model != 'gimbal_speed' and sensor.model != 'gimbal_position' -%}
<joint name="{{ sensor.name }}_joint" type="fixed">
  <parent>base_link</parent><child>{{ sensor.name }}</child>
</joint>
{% endif -%}
