<?xml version="1.0"?>
<!--
  Physical AS2 quadrotor driven at the motor boundary by ArduPilot.

  This deliberately omits AS2's MulticopterVelocityControl plugin.  The stock
  quadrotor_base template leaves a dangling rotorConfiguration block when that
  controller is disabled, producing invalid SDF.  More importantly, including
  the velocity controller would create a second flight controller competing
  with ArduPilot for the same motors.
-->
<sdf version="1.6">
  <model name="{{ namespace }}">
    <include merge="true">
      <uri>model://aerodrone</uri>
    </include>

    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_sensor_pose>true</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>true</publish_nested_model_pose>
      <publish_model_pose>false</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>true</static_publisher>
      <static_update_frequency>100</static_update_frequency>
    </plugin>

{% set directions = ['ccw', 'ccw', 'cw', 'cw'] -%}
{% for motor in range(4) -%}
    <plugin filename="ignition-gazebo-multicopter-motor-model-system"
            name="ignition::gazebo::systems::MulticopterMotorModel">
      <robotNamespace>model/{{ namespace }}</robotNamespace>
      <jointName>rotor_{{ motor }}_joint</jointName>
      <linkName>rotor_{{ motor }}</linkName>
      <turningDirection>{{ directions[motor] }}</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>869.173967493</maxRotVelocity>
      <motorConstant>2.076955719575018e-05</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>{{ motor }}</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>motor_speed/{{ motor }}</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>
{% endfor -%}

    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>

{% for sensor in sensors -%}
    <!-- Payload {{ sensor.model }} -->
{% if sensor.model == 'gimbal_position' -%}
{% include 'gimbal/position_gimbal.sdf.jinja' with context %}
{% elif sensor.model == 'gimbal_speed' -%}
{% include 'gimbal/speed_gimbal.sdf.jinja' with context %}
{% elif sensor.model == 'hd_camera' and not sensor.gimbaled -%}
{% include 'hd_camera/hd_camera.sdf.jinja' with context %}
{% elif sensor.model == 'vga_camera' and not sensor.gimbaled -%}
{% include 'vga_camera/vga_camera.sdf.jinja' with context %}
{% elif sensor.model == 'semantic_camera' and not sensor.gimbaled -%}
{% include 'semantic_camera/semantic_camera.sdf.jinja' with context %}
{% elif sensor.model == 'rgbd_camera' and not sensor.gimbaled -%}
{% include 'rgbd_camera/rgbd_camera.sdf.jinja' with context %}
{% elif not sensor.gimbaled -%}
    <include>
      <name>{{ sensor.name }}</name>
      <uri>model://{{ sensor.model }}</uri>
      <pose relative_to="base_link">{{ sensor.pose }}</pose>
    </include>
    <joint name="{{ sensor.name }}_joint" type="fixed">
      <parent>base_link</parent><child>{{ sensor.name }}</child>
    </joint>
{% endif -%}
{% endfor -%}

    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>
  </model>
</sdf>
