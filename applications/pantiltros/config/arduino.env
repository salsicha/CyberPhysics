# Turret Arduino hardware defaults.
# Override these when the Arduino enumerates on a different device.
TURRET_ARDUINO_PORT=/dev/ttyACM0
TURRET_ARDUINO_BAUD=115200
TURRET_ARDUINO_DRY_RUN=false
# serial: the line protocol on TURRET_ARDUINO_PORT (UNO R4 WiFi). The UNO Q
# uses arduino_uno_q.env (uno_q_bridge) instead.
TURRET_ARDUINO_TRANSPORT=serial
# The foam dart launcher (its priming rack, a third ST3215, ID 14, and its
# trigger servo, ID 15): both turrets carry it. false for a turret without
# one (and, on an Arduino, firmware built with TURRET_ACTUATOR_FITTED 0).
TURRET_ACTUATOR_FITTED=true
