# Turret bridge on the Arduino UNO Q's Linux side (compositions/turret_uno_q.yaml):
# RouterBridge RPC to the board's MCU through the arduino-router socket
# instead of a USB serial port.
TURRET_ARDUINO_TRANSPORT=uno_q_bridge
TURRET_ROUTER_SOCKET=/var/run/arduino-router.sock
TURRET_ARDUINO_DRY_RUN=false
