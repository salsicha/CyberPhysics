# Turret servos driven straight from a Linux host, no Arduino: the bridge's
# sts transport talks the Feetech STS protocol to the ST3215s at 1 Mbps
# through a half-duplex bus servo adapter (Waveshare Bus Servo Adapter (A)).
# Default: the Jetson's 40-pin header UART (pins 8 TX and 10 RX, 3.3 V), with
# the adapter's jumper on A (UART). With the same adapter on USB instead
# (jumper on B), only the port changes: its /dev/serial/by-id/... path.
# Servo IDs, offsets, speed and limits: config/arduino_bridge.yaml.
TURRET_ARDUINO_PORT=/dev/ttyTHS1
TURRET_ARDUINO_BAUD=1000000
TURRET_ARDUINO_TRANSPORT=sts
TURRET_ARDUINO_DRY_RUN=false
# The foam dart launcher (its priming rack, a third ST3215, ID 14, and its
# trigger servo, ID 15): both turrets carry it. false for a turret without
# one (and, on an Arduino, firmware built with TURRET_ACTUATOR_FITTED 0).
TURRET_ACTUATOR_FITTED=true
