# Aerodrone object tracker (applications/aerostack2/scripts/aerodrone_tracker.py,
# systems/aerodrone/tracking.md): limits, follow-mode defaults and tuning.
# compositions/aerodrone_tracking.yaml's fallbacks repeat these values for
# the aircraft (tools/check_compose_env_defaults.py keeps them equal); the
# three simulator stacks include it with this file.

# Height above ground of every set-point (contract limits).
TRACKING_MIN_AGL_M=15.0
TRACKING_MAX_AGL_M=120.0
# Horizontal and vertical speed of the position reference. ArduPilot flies
# GUIDED position targets at no more than WPNAV_SPEED (5 m/s in
# config/arducopter.params) either way.
TRACKING_MAX_SPEED_MPS=5.0
TRACKING_MAX_VERTICAL_SPEED_MPS=1.5
TRACKING_MAX_YAW_RATE_DPS=30.0
# Farthest the reference runs ahead of the aircraft horizontally: ArduPilot
# would fly toward a farther target at WPNAV_SPEED whatever the limit above.
TRACKING_MAX_REFERENCE_LEAD_M=15.0
# The set-points aim at the target predicted TRACKING_LEAD_S ahead, plus a
# lead learnt (at TRACKING_LEAD_ADAPT_RATE per second, up to
# TRACKING_MAX_LEAD_EXTRA_S more) from how far the aircraft trails a target
# moving steadily: ArduPilot lags a moving GUIDED position target (about
# 3 s at 4 m/s in Gazebo, where 2.5 s was tuned).
TRACKING_LEAD_S=2.5
TRACKING_LEAD_ADAPT_RATE=0.2
TRACKING_MAX_LEAD_EXTRA_S=2.5
# A target unseen this long: hover in place (state lost).
TRACKING_LOST_TIMEOUT_S=3.0
# Slant mode defaults when the command omits them.
TRACKING_SLANT_RANGE_M=60.0
TRACKING_DEPRESSION_DEG=70.0
# The slant depression is raised until the target stays this far inside the
# image edge along the long axis (60 deg with the OAK-1's 69 deg field).
TRACKING_FOV_MARGIN_DEG=4.5
# Geolocation noise: box centre (px), attitude (deg), terrain height (m).
TRACKING_PIXEL_SIGMA_PX=3.0
TRACKING_ATTITUDE_SIGMA_DEG=1.0
TRACKING_TERRAIN_SIGMA_M=3.0
# The target filter's process noise (white acceleration, m/s^2): larger
# follows sharper turns, smaller smooths the velocity the lead uses.
TRACKING_PROCESS_ACCEL_MPS2=1.5
