# Aerodrone Navigator/ArduCopter HARDWARE baseline: this is the file to load
# on the aircraft. Pre-arm checks and the RC (throttle) and GCS failsafes stay
# enabled; ArduPilot's default auto-disarm delay applies.
#
# Load arducopter_gps_input.params after it on the aircraft too (GPS-denied
# corrections, ../README.md). Simulators layer it first, then the SITL-only
# relaxations in arducopter_sitl.params, then arducopter_gps_input.params
# (unless GPS_INPUT_CORRECTIONS=false) and backend physics compensation
# (applications/{genesis,isaac}/config/aerodrone_sitl.params); see
# applications/ardupilot_sitl/scripts/run_arducopter_sitl.sh.
FRAME_CLASS,1
FRAME_TYPE,1
ARMING_CHECK,1
# 1 = RTL on loss of RC throttle / GCS heartbeat.
FS_THR_ENABLE,1
FS_GCS_ENABLE,1
MOT_THST_HOVER,0.67
WPNAV_SPEED,500
WPNAV_ACCEL,200
