# Canonical Aerodrone interface. Hardware and simulator deployments expose the
# same vehicle identity; simulator-only ground truth remains explicitly named.
DRONE_NAMESPACE=aerodrone
VEHICLE_NAMESPACE=aerodrone
CAMERA_TOPIC_ROOT=/oak1

GPS_TOPIC=/aerodrone/sensor_measurements/gps
ODOM_TOPIC=/aerodrone/sensor_measurements/odom
RAW_ODOM_TOPIC=/aerodrone/sensor_measurements/odom
IMU_TOPIC=/aerodrone/sensor_measurements/imu
POSE_TOPIC=/aerodrone/ground_truth/pose
TWIST_TOPIC=/aerodrone/ground_truth/twist
# Simulator IMU fed to ArduPilot SITL; IMU_TOPIC is ArduPilot's IMU (MAVROS).
GAZEBO_IMU_TOPIC=/aerodrone/ground_truth/imu
NAVIGATION_ODOM_TOPIC=/navigation/odometry
DEMNAV_ODOM_TOPIC=/demnav/odometry

# Simulator-native nadir camera topics. Hardware uses the OAK-1 topics below.
DEPTH_TOPIC=/aerodrone/sensor_measurements/downward_rgbd/depth
CAMERA_INFO_TOPIC=/aerodrone/sensor_measurements/downward_rgbd/depth/camera_info
WILDNAV_IMAGE_TOPIC=/aerodrone/sensor_measurements/downward_rgb/image_raw
WILDNAV_CAMERA_INFO_TOPIC=/aerodrone/sensor_measurements/downward_rgb/camera_info

GPS_STANDARD_TOPIC=/navigation/gps_standard
FC_IMU_TOPIC=/aerodrone/imu/data_raw
COMPASS_TOPIC=/aerodrone/compass/magnetic_field
BAROMETER_TOPIC=/aerodrone/barometer
OAK_IMAGE_TOPIC=/oak1/image_highres
OAK_IMAGE_INFO_TOPIC=/oak1/image_highres/camera_info
OAK_RELATIVE_DEPTH_TOPIC=/oak1/relative_depth
OAK_DEPTH_INFO_TOPIC=/oak1/camera_info
RANGEFINDER_TOPIC=/aerodrone/rangefinder
# Heading of the OAK-1 image top relative to the nose, degrees counter-clockwise
# seen from above (0 = image top toward the nose). Must match the physical
# OAK-1 mount: a wrong value rotates every DemNav/WildNav match. 0.0 is the
# NOMINAL value for a forward-aligned nadir mount (camera looking straight
# down, image top toward the nose), an assumption until confirmed on the
# built aircraft by flying over a known landmark or checking a still image.
CAMERA_MOUNT_YAW_DEG=0.0
# Forward accepted DemNav/WildNav fixes to ArduPilot as GPS 2 (MAVLink
# GPS_INPUT) for GPS-denied flight; false turns it off. On hardware the
# bridge only arms it once the flight controller reports
# config/arducopter_gps_input.params (see ../README.md).
GPS_INPUT_CORRECTIONS=true
BATTERY_TOPIC=/aerodrone/battery_voltage
BATTERY_STATE_TOPIC=/aerodrone/battery
RC_FAILSAFE_TOPIC=/aerodrone/rc_failsafe
GEOFENCE_TOPIC=/aerodrone/geofence_violation
EMERGENCY_LAND_TOPIC=/aerodrone/emergency_land
