# ROS 2 stays in place; native Zenoh replaces DDS. Peer discovery supports
# local/LAN Compose stacks without blocking on a separate router process.
# For routed networks override ZENOH_CONFIG_OVERRIDE with explicit endpoints.
RMW_IMPLEMENTATION=${RMW_IMPLEMENTATION:-rmw_zenoh_cpp}
ZENOH_ROUTER_CHECK_ATTEMPTS=${ZENOH_ROUTER_CHECK_ATTEMPTS:--1}
ZENOH_CONFIG_OVERRIDE=${ZENOH_CONFIG_OVERRIDE:-scouting/multicast/enabled=true;listen/endpoints=["tcp/0.0.0.0:0"];connect/endpoints=[]}
