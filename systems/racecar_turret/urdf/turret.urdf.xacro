<?xml version="1.0"?>
<!--
  The printed pan/tilt turret (hardware/parts/turret) as a macro, used by
  racecar_turret.urdf.xacro (on the RACECAR's turret plate) and
  turret_printed.urdf.xacro (the standalone turret on its base plate).

  pantilt_turret(parent, xyz, launcher): turret/base_link at ``xyz`` in
  ``parent``. turret/base_link is the underside of a 5 mm plate under the
  pan base (the RACECAR Turret's plate; the standalone base plate is 8 mm,
  so its file puts turret/base_link 3 mm up). Pan first, then tilt: the
  tilt axis 0.100 m above turret/base_link, the camera 0.035 m ahead of it.
  Joint names and signs are those of /turret/joint_states and the
  PanTiltROS tracker: pan_joint positive turns the camera right (image +u),
  tilt_joint positive turns it up (image -v).

  launcher:=true adds the foam dart launcher on the tilt stage
  (systems/racecar_turret/interfaces.md, "Foam dart launcher"; printed
  design in hardware/parts/turret/_launcher.py): the body as
  turret/launcher_link (fixed), actuator_joint (prismatic, the priming
  rack: 0 forward at rest, positive back, 0.038 m primes it; rack force and
  speed from the ST3215 through its 13.5 mm pinion), trigger_joint
  (revolute: 0 safe, the sear engaged; 0.6 rad lifts the sear) and
  turret/muzzle at the barrel's exit, x along the bore. A turret without a
  launcher sets it false.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Turret geometry (metres, radians); systems/racecar_turret/interfaces.md -->
  <xacro:property name="pan_axis_height" value="0.045"/>
  <xacro:property name="tilt_axis_height" value="0.055"/>
  <xacro:property name="camera_forward" value="0.035"/>
  <xacro:property name="pan_limit" value="1.5708"/>
  <xacro:property name="tilt_min" value="-0.65"/>
  <xacro:property name="tilt_max" value="0.75"/>
  <!-- ST3215 at 12 V: about 2.9 N m stall, 0.222 s per 60 degrees -->
  <xacro:property name="servo_effort" value="2.9"/>
  <xacro:property name="servo_velocity" value="4.7"/>
  <!-- Launcher (hardware/parts/turret/_launcher.py, in turret/tilt_link) -->
  <xacro:property name="launcher_rack_origin" value="-0.1035 0 0.058"/>
  <xacro:property name="launcher_prime" value="0.038"/>
  <xacro:property name="launcher_pinion_radius" value="0.0135"/>
  <xacro:property name="launcher_trigger_origin" value="-0.109 0.021375 0.059"/>
  <xacro:property name="launcher_trigger_fire" value="0.6"/>
  <xacro:property name="launcher_muzzle_xyz" value="0.133 0 0.048"/>

  <xacro:macro name="pantilt_turret" params="parent xyz launcher:=true">
    <!-- The plate and the pan servo, whose body is fixed on it (ST3215,
         45 x 25 x 35 mm, output shaft up at the pan axis) -->
    <link name="turret/base_link">
      <visual>
        <origin xyz="0 0 0.0025" rpy="0 0 0"/>
        <geometry><box size="0.11 0.11 0.005"/></geometry>
        <material name="turret_grey"><color rgba="0.35 0.35 0.38 1"/></material>
      </visual>
      <visual>
        <origin xyz="-0.01 0 0.0225" rpy="0 0 0"/>
        <geometry><box size="0.045 0.025 0.035"/></geometry>
        <material name="turret_black"><color rgba="0.05 0.05 0.05 1"/></material>
      </visual>
      <inertial>
        <mass value="0.18"/>
        <origin xyz="-0.0033 0 0.0092" rpy="0 0 0"/>
        <inertia ixx="0.00014" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00025"/>
      </inertial>
    </link>
    <joint name="turret_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="turret/base_link"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
    </joint>

    <!-- Pan stage: the bracket on the pan servo's horn and the tilt servo it
         carries -->
    <link name="turret/pan_link">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry><box size="0.045 0.06 0.04"/></geometry>
        <material name="turret_grey"/>
      </visual>
      <inertial>
        <mass value="0.09"/>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <inertia ixx="0.000039" ixy="0" ixz="0" iyy="0.000027" iyz="0" izz="0.000042"/>
      </inertial>
    </link>
    <joint name="pan_joint" type="revolute">
      <parent link="turret/base_link"/>
      <child link="turret/pan_link"/>
      <origin xyz="0 0 ${pan_axis_height}" rpy="0 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit lower="${-pan_limit}" upper="${pan_limit}" effort="${servo_effort}" velocity="${servo_velocity}"/>
    </joint>

    <!-- Tilt stage: the camera on the tilt servo's horn -->
    <link name="turret/tilt_link">
      <visual>
        <origin xyz="0.015 0 0" rpy="0 0 0"/>
        <geometry><box size="0.05 0.045 0.035"/></geometry>
        <material name="turret_black"/>
      </visual>
      <inertial>
        <mass value="0.08"/>
        <origin xyz="0.015 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
      </inertial>
    </link>
    <joint name="tilt_joint" type="revolute">
      <parent link="turret/pan_link"/>
      <child link="turret/tilt_link"/>
      <origin xyz="0 0 ${tilt_axis_height}" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${tilt_min}" upper="${tilt_max}" effort="${servo_effort}" velocity="${servo_velocity}"/>
    </joint>

    <!-- Turret camera body, x forward / y left / z up, and its optical frame -->
    <link name="turret/camera_link"/>
    <joint name="turret_camera_joint" type="fixed">
      <parent link="turret/tilt_link"/>
      <child link="turret/camera_link"/>
      <origin xyz="${camera_forward} 0 0" rpy="0 0 0"/>
    </joint>
    <link name="turret/camera_optical_frame"/>
    <joint name="turret_camera_optical_joint" type="fixed">
      <parent link="turret/camera_link"/>
      <child link="turret/camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>

    <xacro:if value="${launcher}">
      <!-- Launcher body: plunger tube, breech, clip (full), barrel, the
           actuator and trigger servos, mounts; masses from the printed
           design's estimates -->
      <link name="turret/launcher_link">
        <visual>
          <origin xyz="-0.0405 0 0.058" rpy="0 1.57079632679 0"/>
          <geometry><cylinder radius="0.0184" length="0.089"/></geometry>
          <material name="turret_grey"/>
        </visual>
        <visual>
          <origin xyz="0.054 0.017 0.044" rpy="0 0 0"/>
          <geometry><box size="0.092 0.061 0.025"/></geometry>
          <material name="turret_grey"/>
        </visual>
        <visual>
          <origin xyz="0.05 0.017 0.104" rpy="0 0 0"/>
          <geometry><box size="0.077 0.018 0.093"/></geometry>
          <material name="turret_grey"/>
        </visual>
        <visual>
          <origin xyz="0.1105 0 0.048" rpy="0 1.57079632679 0"/>
          <geometry><cylinder radius="0.00675" length="0.045"/></geometry>
          <material name="turret_black"/>
        </visual>
        <inertial>
          <mass value="0.403"/>
          <origin xyz="-0.0247 0.0006 0.0507" rpy="0 0 0"/>
          <inertia ixx="0.000706" ixy="0.000011" ixz="-0.000101" iyy="0.002252" iyz="-0.000171" izz="0.00243"/>
        </inertial>
      </link>
      <joint name="turret_launcher_joint" type="fixed">
        <parent link="turret/tilt_link"/>
        <child link="turret/launcher_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>

      <!-- Priming rack: its origin is the hook's face on the plunger rod's
           collar, at rest; positive draws it back -->
      <link name="turret/launcher_rack_link">
        <visual>
          <origin xyz="0.0833 -0.027 -0.020" rpy="0 0 0"/>
          <geometry><box size="0.167 0.008 0.008"/></geometry>
          <material name="turret_grey"/>
        </visual>
        <inertial>
          <mass value="0.0211"/>
          <origin xyz="0.0689 -0.0258 -0.0175" rpy="0 0 0"/>
          <inertia ixx="0.0000044" ixy="0.0000053" ixz="0.0000028" iyy="0.0000652" iyz="0" izz="0.0000659"/>
        </inertial>
      </link>
      <joint name="actuator_joint" type="prismatic">
        <parent link="turret/tilt_link"/>
        <child link="turret/launcher_rack_link"/>
        <origin xyz="${launcher_rack_origin}" rpy="0 0 0"/>
        <axis xyz="-1 0 0"/>
        <!-- rack force at the servo's stall torque, rack speed at its no-load speed -->
        <limit lower="0" upper="${launcher_prime}" effort="${servo_effort / launcher_pinion_radius}"
               velocity="${servo_velocity * launcher_pinion_radius}"/>
      </joint>

      <!-- Trigger arm on the trigger servo's horn: 0 safe, positive lifts
           the sear -->
      <link name="turret/launcher_trigger_link">
        <inertial>
          <mass value="0.0013"/>
          <origin xyz="0.006 -0.0015 0" rpy="0 0 0"/>
          <inertia ixx="0.00000006" ixy="0" ixz="0" iyy="0.0000001" iyz="0" izz="0.00000006"/>
        </inertial>
      </link>
      <joint name="trigger_joint" type="revolute">
        <parent link="turret/tilt_link"/>
        <child link="turret/launcher_trigger_link"/>
        <origin xyz="${launcher_trigger_origin}" rpy="0 0 0"/>
        <axis xyz="0 -1 0"/>
        <limit lower="0" upper="${launcher_trigger_fire}" effort="${servo_effort}" velocity="${servo_velocity}"/>
      </joint>

      <!-- Muzzle: the barrel's exit, x along the bore -->
      <link name="turret/muzzle"/>
      <joint name="turret_muzzle_joint" type="fixed">
        <parent link="turret/tilt_link"/>
        <child link="turret/muzzle"/>
        <origin xyz="${launcher_muzzle_xyz}" rpy="0 0 0"/>
      </joint>
    </xacro:if>
  </xacro:macro>
</robot>
